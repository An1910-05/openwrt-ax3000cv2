diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
index c6378fd..4f86515 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
@@ -347,6 +347,11 @@ linksys_mx_pre_upgrade() {
 
 platform_check_image() {
 	case "$(board_name)" in
+	fpt,wf810df)
+		[ "$(find_mtd_index rootfs)" = "20" ] &&
+		[ "$(cat /sys/class/mtd/mtd20/size)" = "254803968" ] || return 1
+		nand_do_platform_check "wf810df" "$1"
+		;;
 	cudy,p5)
 		nand_do_platform_check "$(board_name)" "$1"
 		;;
@@ -378,6 +383,13 @@ platform_pre_upgrade() {
 
 platform_do_upgrade() {
 	case "$(board_name)" in
+	fpt,wf810df)
+		# Existing WF810DF rootfs UBI only; never alter protected boot data.
+		[ "$(find_mtd_index rootfs)" = "20" ] &&
+		[ "$(cat /sys/class/mtd/mtd20/size)" = "254803968" ] || return 1
+		CI_UBIPART="rootfs"
+		nand_do_upgrade "$1"
+		;;
 	cudy,p5)
 		cudy_p5_do_upgrade "$1"
 		;;
