diff --git a/package/nss/nss-tools/files/nss-dwmac-up b/package/nss/nss-tools/files/nss-dwmac-up
index 348fc7a..89aebfc 100644
--- a/package/nss/nss-tools/files/nss-dwmac-up
+++ b/package/nss/nss-tools/files/nss-dwmac-up
@@ -340,3 +340,12 @@ done
 
 # Last, so nothing above waits on it (see wifi_sync_netifd).
 wifi_sync_netifd
+
+# WF810DF keeps the proprietary-tag LAN on the host. Apply its native-LAN
+# path only after the NSS plane and IRQ placement are complete.
+if [ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "fpt,wf810df" ] &&
+   grep -q 'phys_if 0: started dev=wan' "$GLUE_STATUS"; then
+    touch /var/run/wf810df-nss-plane-ready
+    /usr/libexec/wf810df-nss-host-lan || echo "WARN: WF810DF native LAN path did not apply"
+fi
+exit 0
