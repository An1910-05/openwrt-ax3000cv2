#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# First boot and factory reset: generic defaults, no device-specific identity.
printf '%s\n' admin admin | passwd root >/dev/null 2>&1 || exit 1
uci -q set system.@system[0].hostname='AX3000CV2'
uci -q set system.@system[0].zonename='Asia/Ho_Chi_Minh'
uci -q set system.@system[0].timezone='ICT-7'
uci -q set network.globals.packet_steering='1'
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit system
uci -q commit network
uci -q commit firewall
# Radios stay disabled until the owner sets country, SSID and Wi-Fi password.
/etc/init.d/internet_led enable
/etc/init.d/wf810df_nss_host_lan enable
exit 0
